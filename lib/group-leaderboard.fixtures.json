      "expectMs": 0
    },
    {
      "name": "a pause longer than the span reads zero",
      "now": "2026-10-22T00:00:00.000Z",
      "sessions": [{ "start": "2026-10-20T10:00:00.000Z", "end": "2026-10-20T10:30:00.000Z", "pausedMin": 45 }],
      "expectMs": 0
