{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/AlertDialog/**",
              "components/general/Badge/**",
              "components/general/BottomNav/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/CategoryMarker/**",
              "components/general/CategoryPicker/**",
              "components/general/Checkbox/**",
              "components/general/ColorSwatches/**",
              "components/general/Dialog/**",
              "components/general/GoalProgressBar/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/general/PageSkeleton/**",
              "components/general/Separator/**",
              "components/general/Tabs/**",
              "components/general/Textarea/**",
              "components/general/Toaster/**",
              "components/general/WeekBreakdown/**",
              "components/general/WeekStrip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, Newsreader."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
